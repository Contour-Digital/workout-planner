# Supabase project connection (safe to expose to the client — the anon/publishable
# key is designed for browser use; access is enforced by Postgres row-level security).
# Find these in your Supabase project: Settings -> API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
